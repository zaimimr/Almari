      "layer": "style",
      "if": {
        "all": [
          { "has": { "role": ["main"], "category": ["dress"] } },
          { "has": { "role": ["bottom"] } },
          {
            "not": {
              "has": { "category": ["dress"], "length": ["thigh", "knee"] }
            }
          }
        ]
      },
      "weight": -2.5
    },
    {
      "id": "hijab-solid-with-print",
      "source": "western-hijab:1",
      "layer": "style",
      "if": {
        "all": [
          {
            "has": { "role": ["main"], "pattern": ["print", "stripe", "check"] }
          },
          { "has": { "role": ["hijab"], "pattern": ["solid"] } }
        ]
      },
      "weight": 1.0,
      "reason": true
    },
    {
      "id": "hijab-from-print",
      "source": "western-hijab:2",
      "layer": "color",
      "if": {
        "pair": [
          { "role": ["hijab"], "pattern": ["solid"] },
          {
            "role": ["main"],
            "pattern": ["print", "stripe", "check", "embroidered"]
          }
        ],
        "relation": "echo"
      },
      "weight": 0.6,
      "reason": true
    },
    {

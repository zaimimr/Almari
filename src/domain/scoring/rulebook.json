  "rules": [
    {
      "id": "occasion-tags-match",
      "source": "legacy:occasion-tags",
      "layer": "style",
      "if": {
        "all": [
          { "has": { "tagged": "occasion" } },
          { "has": { "tagged": "other" }, "count": { "max": 0 } }
        ]
      },
      "weight": 1.0
    },
    {
      "id": "occasion-tag-mismatch",
      "source": "legacy:occasion-tags",
      "layer": "style",
      "if": { "has": { "tagged": "other" } },
      "weight": -1.5
    },
    {
      "id": "layer-for-cold",
      "source": "legacy:weather",
      "layer": "style",
      "when": { "weather": ["cold"] },
      "if": { "has": { "role": ["layer", "outer"] } },
      "weight": 2.0,
      "reason": true
    },
    {
      "id": "layer-for-mild",
      "source": "legacy:weather",
      "layer": "style",
      "when": { "weather": ["mild"] },
      "if": { "has": { "role": ["layer", "outer"] } },
      "weight": 0.5,
      "reason": true
    },
    {
      "id": "layer-at-work",
      "source": "legacy:work-layer",
      "layer": "style",
      "when": { "occasion": ["work"], "weather": ["unknown", "warm"] },
      "if": { "has": { "role": ["layer", "outer"] } },
      "weight": 0.5,
      "reason": true
    },
    {
      "id": "blazer-at-work",
      "source": "owner:work",
      "layer": "style",

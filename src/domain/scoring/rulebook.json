      "if": { "has": { "kind": ["blazer"] } },
      "weight": 0.8
    },
    {
      "id": "two-layers-not-cold",
      "source": "legacy:layers",
      "layer": "style",
      "when": { "weather": ["unknown", "warm", "mild"] },
      "if": {
        "all": [
          { "has": { "role": ["layer"] } },
          { "has": { "role": ["outer"] } }
        ]
      },
      "weight": -1.5
    },
    {
      "id": "blazer-under-abaya",

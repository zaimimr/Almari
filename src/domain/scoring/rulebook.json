        "all": [
          {
            "has": {
              "role": ["hijab"],
              "pattern": ["print", "stripe", "check"]
            }
          },
          { "has": { "role": ["main"], "pattern": ["solid"] } },
          {
            "not": {
              "has": {
                "role": ["bottom", "layer", "outer"],
                "pattern": ["print", "stripe", "check"]
              }
            }
          }
        ]
      },
      "weight": 0.6,
      "reason": true
    },

{
  "version": 1,
  "thresholds": {
    "neutralChroma": 8,
    "vividChroma": 15,
    "mutedChroma": 35,
    "loudChroma": 50,
    "saturatedChroma": 45,
    "sameDE": 5,
    "nearMissDE": [5, 12],
    "nearMissHue": 25,
    "tonalHue": 20,
    "tonalMinDL": 15,
    "analogousHue": [20, 60],
    "complementHue": [150, 210],
    "mutedDL": 25,
    "echoDE": 10,
    "accentJoinDE": 12,
    "contrastDL": 25,
    "lightL": 75,
    "paletteShare": 0.15,
    "bestDE": 10

{
  "expo": {
    "name": "Almari",
    "slug": "almari",
    "version": "0.1.0",
    "scheme": "almari",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "platforms": ["ios", "web"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.zaimimran.almari",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose clothing photos to add to your closet.",
          "cameraPermission": "Photograph a piece for your closet.",
          "microphonePermission": false
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "26.0",
            "enableSceneSupport": true
          }
        }
      ],
      "expo-status-bar",
      "expo-image",
      "expo-sqlite",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/icon.png",
          "imageWidth": 220,
          "backgroundColor": "#FDFBF7"
        }
      ]
    ],
    "icon": "./assets/brand/icon.png"
  }
}

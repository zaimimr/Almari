{
  "expo": {
    "name": "Almari",
    "slug": "almari",
    "version": "0.1.13",
    "scheme": "almari",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "platforms": ["ios", "web"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.zaimimran.almari",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CADisableMinimumFrameDurationOnPhone": true
      },
      "entitlements": {
        "com.apple.developer.weatherkit": true
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-font",
        {
          "fonts": [
            "./node_modules/@expo-google-fonts/fraunces/400Regular/Fraunces_400Regular.ttf",
            "./node_modules/@expo-google-fonts/fraunces/600SemiBold/Fraunces_600SemiBold.ttf"
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose clothing photos to add to your closet.",
          "cameraPermission": "Photograph your clothes, or take a selfie to find your colours.",
          "microphonePermission": false
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "26.0",
            "enableSceneSupport": true
          }
        }
      ],
      "expo-status-bar",
      "expo-image",
      "expo-sqlite",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/tile.png",
          "imageWidth": 160,
          "backgroundColor": "#FFFFFF"
        }
      ],
      "expo-localization",
      "./plugins/withoutPush",
      [
        "expo-notifications",
        {
          "icon": "./assets/brand/icon.png",
          "color": "#675469"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Find your city for the weather. Rounded to your city, sent only to Apple for the forecast."
        }
      ]
    ],
    "icon": "./assets/brand/icon.png",
    "locales": {
      "nb": "./locales/nb.json"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9de17712-f6aa-44ba-9cb1-212d845635d2"
      }
    },
    "owner": "zaim"
  }
}

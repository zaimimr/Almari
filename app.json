{
  "expo": {
    "name": "Almari",
    "slug": "almari",
    "version": "0.1.1",
    "scheme": "almari",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "platforms": ["ios", "web"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.zaimimran.almari",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.developer.weatherkit": true,
        "com.apple.developer.kernel.increased-memory-limit": true
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose clothing photos to add to your closet.",
          "cameraPermission": "Photograph your clothes, or take a selfie to find your colours.",
          "microphonePermission": false
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "26.0",
            "enableSceneSupport": true
          }
        }
      ],
      "expo-status-bar",
      "expo-image",
      "expo-sqlite",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/icon.png",
          "imageWidth": 220,
          "backgroundColor": "#FDFBF7"
        }
      ],
      "expo-localization"
    ],
    "icon": "./assets/brand/icon.png",
    "locales": {
      "nb": "./locales/nb.json"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9de17712-f6aa-44ba-9cb1-212d845635d2"
      }
    },
    "owner": "zaim"
  }
}

set -eu
device="${DEVICE:-Closet Development}"
data=$(xcrun simctl get_app_container "$device" com.zaimimran.almari data)
sqlite3 "$data/Documents/SQLite/ExpoSQLiteStorage" "select value from storage where key = 'closet.v3'" | jq -e '.pieces[] | select(.id == "seed-tunic") | .original == "seed-tunic-original.png" and .photo == .variants.studio and (.photo | contains("-studio-"))' >/dev/null
